# Copy to .env at repository root. Model API keys are never stored on the server;
# configure them in the web page so they remain in your browser localStorage.
YUNFAN_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
# Set to a model that your Zhipu account can access.
YUNFAN_MODEL=glm-4-flash
YUNFAN_LLM_MODE=auto
YUNFAN_TIMEOUT_SECONDS=60
YUNFAN_MAX_RETRIES=2
# Optional: leave empty for model-default behavior; low/high/max is only valid for supported GLM models.
YUNFAN_REASONING_EFFORT=
YUNFAN_RAG_MODE=local
YUNFAN_BATCH_CONCURRENCY=2
YUNFAN_PORT=18001
# Keep 127.0.0.1 for same-host use. Use 0.0.0.0 only on a trusted private LAN.
YUNFAN_BIND_HOST=127.0.0.1
# Comma-separated exact origins only; wildcards are rejected. The bundled extension
# has a stable ID because its manifest contains a public key.
YUNFAN_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,chrome-extension://jdacbgmhcbpkoccblehfahhoekjiiopl
# Hostnames accepted by the server. Add the exact LAN IP or DNS name used by other
# trusted devices. Do not use * and do not expose this no-account service publicly.
YUNFAN_ALLOWED_HOSTS=127.0.0.1,localhost,::1
