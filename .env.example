# Copy to .env at repository root. Never commit the real key.
JOBFIT_API_KEY=
JOBFIT_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
# Set to a model that your Zhipu account can access.
JOBFIT_MODEL=glm-4-flash
JOBFIT_LLM_MODE=auto
JOBFIT_TIMEOUT_SECONDS=60
JOBFIT_MAX_RETRIES=2
# Optional: leave empty for model-default behavior; low/high/max is only valid for supported GLM models.
JOBFIT_REASONING_EFFORT=
JOBFIT_RAG_MODE=local
JOBFIT_BATCH_CONCURRENCY=2
JOBFIT_PORT=8000
JOBFIT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
