{
  "manifest_version": 3,
  "name": "JobFit BOSS 职位采集器",
  "version": "1.0.0",
  "description": "采集用户当前打开的 BOSS 直聘页面中已显示的职位，并导入本机 JobFit 服务。",
  "permissions": [
    "storage",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "action": {
    "default_title": "采集 BOSS 当前页职位",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "key": "",
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
